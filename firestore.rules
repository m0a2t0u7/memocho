rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 許可リスト：ここに使う人のメールアドレスを書く
    function allowed() {
      return request.auth != null
        && request.auth.token.email in ['ken2799@gmail.com'];
    }
    match /messages/{id} {
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if allowed() && resource.data.uid == request.auth.uid;
    }
    match /reads/{uid} {
      allow read: if allowed();
      allow write: if allowed() && uid == request.auth.uid;
    }
    // それ以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
